# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 커밋하지 않습니다.

# ===== 사용내역 MCP (MyFinance) =====
# 채점·시연용 테스트 서버(가상 데이터). 직접 배포한 서버를 쓰면 그 주소로 바꾸세요.
SPEND_MCP_URL=https://test.finance.zswagger.com/api/mcp

# 최초 1회 브라우저 로그인 후 돌아올 로컬 콜백 포트 (다른 프로그램과 겹치면 변경)
SPEND_MCP_CALLBACK_PORT=8765

# OAuth 토큰 저장 위치 (저장소 밖에 둡니다)
SPEND_MCP_TOKEN_PATH=~/.card-bep/oauth.json

# ===== Amazon Bedrock =====
# AWS 키를 비워두면 상위 폴더(sds-ax-practice/.env) 또는 AWS 기본 자격증명을 사용합니다.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL=global.anthropic.claude-sonnet-4-6
# 토큰 한도에 걸리면 다음 모델로 자동 전환합니다. 순서를 바꾸려면 쉼표로 나열하세요 (비워두면 기본 목록).
# BEDROCK_MODELS=global.anthropic.claude-sonnet-4-6,us.anthropic.claude-sonnet-4-6,global.anthropic.claude-sonnet-4-5-20250929-v1:0,us.anthropic.claude-sonnet-4-5-20250929-v1:0,global.anthropic.claude-haiku-4-5-20251001-v1:0,us.anthropic.claude-haiku-4-5-20251001-v1:0,us.amazon.nova-pro-v1:0,global.amazon.nova-2-lite-v1:0,us.amazon.nova-2-lite-v1:0,us.amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ===== POST /query 서버 =====
AGENT_PORT=8000
